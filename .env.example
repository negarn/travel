# Optional: set the canonical public origin when serving behind a reverse proxy.
# Use the exact scheme and host, such as https://travel.example.com.
# TRAVEL_PUBLIC_ORIGIN=https://travel.example.com

# Optional: require Google sign-in before opening the app.
# Set the exact Google account that may sign in. When this is set, Google auth
# is enforced for app pages and API routes.
# TRAVEL_AUTH_ALLOWED_EMAIL=you@example.com
# TRAVEL_AUTH_GOOGLE_CLIENT_ID=
# TRAVEL_AUTH_GOOGLE_CLIENT_SECRET=
# TRAVEL_AUTH_SESSION_SECRET=replace-with-a-long-random-string

# Cloud sync credentials are optional.
TRAVEL_GOOGLE_DRIVE_CLIENT_ID=
TRAVEL_GOOGLE_DRIVE_CLIENT_SECRET=
TRAVEL_DROPBOX_CLIENT_ID=
TRAVEL_DROPBOX_CLIENT_SECRET=

# Google Maps credentials are optional.
TRAVEL_GOOGLE_MAPS_API_KEY=
VITE_TRAVEL_GOOGLE_MAPS_EMBED_API_KEY=
